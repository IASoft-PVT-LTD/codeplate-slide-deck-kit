    },
    {
      "path": "assets/fonts/Inter-Italic.ttf",
      "kind": "font",
      "use": "Inter Italic: Emphasis. The body font (--body-font in theme/brand.css).",
      "license": "OFL-1.1",
      "licenseFile": "assets/fonts/OFL-Inter.txt",
      "credit": "The Inter Project Authors (Rasmus Andersson)",
      "source": "https://github.com/rsms/inter/releases/tag/v4.1"
    },
    {
      "path": "assets/fonts/Inter-SemiBold.ttf",
      "kind": "font",
      "use": "Inter SemiBold: Table headings and chart values. The body font (--body-font in theme/brand.css).",
      "license": "OFL-1.1",
      "licenseFile": "assets/fonts/OFL-Inter.txt",
      "credit": "The Inter Project Authors (Rasmus Andersson)",
      "source": "https://github.com/rsms/inter/releases/tag/v4.1"
    },
    {
      "path": "assets/fonts/Inter-Bold.ttf",
      "kind": "font",
      "use": "Inter Bold: Bold text. The body font (--body-font in theme/brand.css).",

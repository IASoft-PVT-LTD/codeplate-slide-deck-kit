    {
      "path": "assets/logo.svg",
      "kind": "image",
      "width": 160,
      "height": 160,
      "use": "The sample company logo (Loamly) on the pitch title slide. Replace it with the user's logo (SVG best).",
      "license": "CodePlate-original",
      "credit": "CodePlate"
    },
    {
      "path": "assets/images/street.svg",
      "kind": "image",
      "width": 512,
      "height": 720,
      "use": "Pitch slide 2: a street of houses, shown on the right 40% of the slide (![bg right:40% …]). 512x720 fills that area exactly.",
      "license": "CodePlate-original",
      "credit": "CodePlate"
    },
    {
      "path": "assets/images/tool-shelf.svg",
      "kind": "image",
      "width": 512,
      "height": 720,
      "use": "Pitch slide 3: a shelf of shared tools, right 40% of the slide.",
      "license": "CodePlate-original",
      "credit": "CodePlate"
    },
    {
      "path": "assets/images/water-cycle.svg",
      "kind": "image",
      "width": 512,
      "height": 720,
      "use": "Lesson slide 4: the water cycle without words (works in any language), right 40% of the slide.",
      "license": "CodePlate-original",
      "credit": "CodePlate"
    }
  ]
